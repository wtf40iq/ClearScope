{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearScope",
  "version": "../package.json",
  "identifier": "app.clearscope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClearScope",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#1c1c1f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Fast disk space analyzer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "ClearScope"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "wtf40iq",
    "homepage": "https://github.com/wtf40iq/ClearScope",
    "copyright": "© wtf40iq",
    "longDescription": "ClearScope — быстрый анализатор занятого места на диске для Windows"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QkYxMkREMTMyMTQwRDMKUldUVFFDRVQzUksvbHJnZHpxZE1zcXhnRnRONjNzQ2xhckRrMXp6TEZFaTRGbThaSllIZlo3NDAK",
      "endpoints": [
        "https://github.com/wtf40iq/ClearScope/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}